# Essai LOCAL : Core sur http://localhost:8080 (yarn start:prod), Penpot sur http://localhost:9001.
# Copier en `.env` (ou `cp .env.local.example .env`) puis : docker compose up -d
#
# `localhost` des deux côtés = même SITE (le port ne compte pas pour un site) : le cookie de session
# fonctionne dans l'iframe. Mais ce sont deux ORIGINES (ports différents) : PENPOT_FRAME_ANCESTORS doit donc
# contenir l'origine EXACTE du Core, telle qu'elle apparaît dans la barre d'adresse. Si vous ouvrez le Core
# sur http://127.0.0.1:8080, l'ajouter aussi (déjà fait ci-dessous).

PENPOT_VERSION=2.19.3
PENPOT_PUBLIC_URI=http://localhost:9001
# `yarn start:prod` annonce « http://0.0.0.0:8080 » : ouvrez plutôt http://localhost:8080 (voir README, « Dépannage »).
# 0.0.0.0 est autorisé ici par tolérance d'essai, mais la session Penpot ne passe dans l'iframe que sous localhost.
PENPOT_FRAME_ANCESTORS=http://localhost:8080 http://127.0.0.1:8080 http://0.0.0.0:8080

# Valeurs d'essai UNIQUEMENT (ne jamais réutiliser en production).
PENPOT_SECRET_KEY=essai-local-ne-pas-utiliser-en-production-0123456789abcdef0123456789abcdef
POSTGRES_PASSWORD=essai-local

# HTTP local : les cookies de session ne peuvent pas être « Secure ».
PENPOT_FLAGS=disable-email-verification enable-smtp enable-prepl-server disable-secure-session-cookies enable-mcp
PENPOT_CSP_MODE=report-only
PENPOT_BIND=127.0.0.1:9001
PENPOT_TELEMETRY_ENABLED=false
