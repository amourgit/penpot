# SPDX-License-Identifier: MPL-2.0
# Copier en `.env` puis adapter. Ne jamais commiter `.env`.

# Version des images officielles penpotapp/* (doit correspondre aux fichiers nginx montés).
PENPOT_VERSION=2.19.3

# URL PUBLIQUE de Penpot, telle que vue par le navigateur (https en production).
PENPOT_PUBLIC_URI=https://design.exemple.org

# Origine(s) du Core autorisée(s) à embarquer Penpot dans une iframe (séparées par des espaces).
# Recommandé : Penpot sur un sous-domaine du MÊME site que le Core (cookies de session normaux).
PENPOT_FRAME_ANCESTORS=https://core.exemple.org

# Secrets : générer des valeurs propres à chaque déploiement.
#   openssl rand -base64 64   → PENPOT_SECRET_KEY
#   openssl rand -base64 24   → POSTGRES_PASSWORD
PENPOT_SECRET_KEY=
POSTGRES_PASSWORD=

# Drapeaux Penpot. Production en HTTPS : retirer `disable-secure-session-cookies`.
# Penpot sur un AUTRE site que le Core : ajouter `enable-cors` (cookie SameSite=None).
PENPOT_FLAGS=disable-email-verification enable-smtp enable-prepl-server enable-mcp

# Politique CSP : report-only (défaut) | enforce | disabled. frame-ancestors est toujours imposé.
PENPOT_CSP_MODE=report-only

# Réseau : interface:port publiés (derrière un reverse proxy TLS), télémétrie, courrier.
PENPOT_BIND=127.0.0.1:9001
PENPOT_TELEMETRY_ENABLED=false
PENPOT_SMTP_HOST=
PENPOT_SMTP_PORT=
PENPOT_SMTP_USERNAME=
PENPOT_SMTP_PASSWORD=
PENPOT_SMTP_TLS=
PENPOT_SMTP_SSL=
